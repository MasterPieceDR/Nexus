# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME=Nexus API
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# ── Base de datos (SQL Server) ────────────────────────────────────────────────
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=NexusDB
DB_USER=nexus_api_user
DB_PASSWORD=coloca_aqui_tu_password
DB_TRUST_CERTIFICATE=yes
DB_ENCRYPT=yes

# ── Seguridad / JWT ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=cambia_esta_clave_por_una_clave_larga_y_segura
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=180

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=coloca_tu_google_client_id
GOOGLE_CLIENT_SECRET=coloca_tu_google_client_secret

# GitHub OAuth — la app "http" sirve el sitio S3 website, la app "https" sirve CloudFront.
GITHUB_CLIENT_ID=coloca_el_client_id_de_la_app_http
GITHUB_CLIENT_SECRET=coloca_el_client_secret_de_la_app_http
GITHUB_CLIENT_ID_HTTPS=coloca_el_client_id_de_la_app_https
GITHUB_CLIENT_SECRET_HTTPS=coloca_el_client_secret_de_la_app_https

# ── Cloud / Almacenamiento multimedia ─────────────────────────────────────────
# CLOUD_PROVIDER: LOCAL | S3 | CLOUDINARY
# LOCAL guarda los archivos en backend/static/ (no requiere credenciales)
CLOUD_PROVIDER=LOCAL
AWS_REGION=us-east-1
AWS_MEDIA_BUCKET=nexus-dev-media
AWS_APP_BUCKET=nexus-dev-app
AWS_S3_BUCKET=
AWS_PRESIGN_EXPIRATION=900
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AUTO_APPROVE_POSTS=false
MAX_UPLOAD_SIZE_MB=15

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password

# ── Moderación IA/OCR ─────────────────────────────────────────────────────────
# MODERATION_PROVIDER: MOCK | GOOGLE_VISION | AWS_REKOGNITION | HF_NSFW
# MOCK deja todo el contenido en PENDING para revisión manual (modo seguro)
MODERATION_PROVIDER=MOCK
HF_API_TOKEN=
HF_NSFW_MODEL=Falconsai/nsfw_image_detection

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# WHATSAPP_PROVIDER: MOCK | TWILIO
# MOCK registra los mensajes en logs sin enviarlos (no requiere credenciales)
WHATSAPP_PROVIDER=MOCK
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ADMIN_WHATSAPP_NUMBER=573001234567
